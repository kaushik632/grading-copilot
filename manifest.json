{
  "manifest_version": 3,
  "name": "AI Grading Co-Pilot",
  "version": "0.1.0",
  "description": "AI-assisted grading sidebar for Canvas and Gradescope. Reads student submissions and drafts scores using your rubric.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.*.edu/*",
    "https://*.gradescope.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.*.edu/*",
        "https://*.gradescope.com/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"]
    }
  ],
  "action": {
    "default_title": "AI Grading Co-Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
